# Dependencies
node_modules/

# Build output
dist/

# Local npm cache (sandboxed installs redirect cache into the workspace)
.npm-cache/

# Task scratch space
.plate-scratch/
.scaffold-tmp/
.selftest/
build-output.txt
check-output.txt
# transient gate/inspection logs at the repo root
.gate-*.txt
.integration-*.txt

# External anatomy downloads (BodyParts3D raw archives + extracted OBJs —
# regenerable via scripts; derived GLBs in src/assets are committed)
.bp3d-probe/
assets-src/

# Per-task scratch workspaces and the run's plan-of-record. These hold raw
# source images, probe crops and intermediate renders (≈200 MB across the set
# at v4b time) that are regenerable from the scripts in the repo — they must
# never be committed by `git add -A`. Listed explicitly rather than as `_*/`
# so an intentional future directory starting with an underscore is not
# silently swallowed.
.dsh-scratch/
.slice-crops/
.v4c-check/
_ctcrops/
_ctwork/
_imgtmp/
_vhp_tmp/
_vhpwork/
_work/
crops/
PLAN.md
